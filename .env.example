# Porta do servidor
PORT=3000

# String de conexao do banco Postgres.
# No Render: va em seu banco Postgres -> "Connections" -> copie a "External Database URL"
# (ou a "Internal Database URL" se o app tambem estiver hospedado no Render, e mais rapido).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gp_projetos

# Deixe "disable" apenas para Postgres local sem SSL. Em producao (Render, Supabase, Neon etc.)
# mantenha removido ou como qualquer valor diferente de "disable" para usar SSL.
# PGSSLMODE=disable

# Configuracao de envio de e-mail (SMTP)
# Exemplo Gmail: host smtp.gmail.com, porta 587, use uma "senha de app" (nao a senha normal)
# Exemplo Outlook 365: host smtp.office365.com, porta 587
# Exemplo SMTP proprio da empresa: pergunte ao time de TI host/porta/usuario/senha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@empresa.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="Painel de Projetos <seuemail@empresa.com>"

# Senha simples de acesso ao painel Admin (protecao basica - troque isso!)
ADMIN_PASSWORD=troque-esta-senha
