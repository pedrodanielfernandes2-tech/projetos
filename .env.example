# Porta do servidor
PORT=3000

# String de conexao do banco Postgres.
# No Render: va em seu banco Postgres -> "Connections" -> copie a "External Database URL"
# (ou a "Internal Database URL" se o app tambem estiver hospedado no Render, e mais rapido).
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gp_projetos

# Deixe "disable" apenas para Postgres local sem SSL. Em producao (Render, Supabase, Neon etc.)
# mantenha removido ou como qualquer valor diferente de "disable" para usar SSL.
# PGSSLMODE=disable

# Configuracao de envio de e-mail via Brevo (API HTTPS, evita bloqueios de porta SMTP)
# 1. Crie conta gratuita em https://www.brevo.com (300 e-mails/dia no plano free)
# 2. Verifique o remetente em Settings -> Senders (precisa confirmar por e-mail)
# 3. Gere uma API Key em SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=sua-api-key-do-brevo

# Remetente exibido para quem recebe o e-mail. O endereco precisa ser o mesmo
# verificado no passo 2 acima.
SMTP_FROM="Painel de Projetos <seuemail@empresa.com>"

# Integracao com Microsoft Teams (opcional).
# 1. No canal do Teams desejado, adicione o conector "Incoming Webhook"
#    (Configuracoes do canal -> Conectores -> Incoming Webhook -> Criar)
# 2. Copie a URL gerada e cole abaixo.
# Sem essa variavel, os recursos de Teams simplesmente ficam desativados (sem erro).
TEAMS_WEBHOOK_URL=

# Senha simples de acesso ao painel Admin (protecao basica - troque isso!)
ADMIN_PASSWORD=troque-esta-senha
